{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 with Qt 6.12",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows",
      "cacheVariables": {
        "STEAMDPI_BUILD_GUI": "ON",
        "STEAMDPI_BUILD_TESTS": "ON",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/msvc2022_64"
      }
    },
    {
      "name": "windows-core-tests",
      "displayName": "Windows core fixtures (without Qt UI)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-core-tests",
      "cacheVariables": {"STEAMDPI_BUILD_GUI": "OFF", "STEAMDPI_BUILD_TESTS": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug"},
    {"name": "release", "configurePreset": "windows", "configuration": "Release"},
    {"name": "core-tests", "configurePreset": "windows-core-tests", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "core-tests", "configurePreset": "windows-core-tests", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
